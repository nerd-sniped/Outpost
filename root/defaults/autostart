#!/usr/bin/with-contenv bash
# Copied to $HOME/.config/openbox/autostart by the base's init-selkies-config, then
# run (via `sh`) as the single foreground app. With RESTART_APP=true the base watchdog
# relaunches it if FreeCAD exits (crash-resilience, Phase 1.1).
#
# Launch the FreeCAD GUI bare — do NOT pass a .py argument: FreeCAD runs a script
# argument in console mode and then EXITS, which the watchdog would just relaunch into
# the same immediate exit (blank stream). Startup wiring lives in the OutpostBoot addon
# (Mod/OutpostBoot/InitGui.py), which FreeCAD loads at GUI init without exiting.
exec /opt/freecad/AppRun
