#!/usr/bin/with-contenv bash
# Selkies base launches this as the single foreground app. With RESTART_APP=true the
# base watchdog relaunches it if FreeCAD exits (the crash-resilience path, Phase 1.1).
#
# freecad_boot.py runs inside FreeCAD's GUI process (main thread) at startup and wires
# GitPDM's SIGTERM checkpoint hook. FreeCAD executes a .py passed on its command line
# after GUI init.
exec /opt/freecad/AppRun /opt/outpost/freecad_boot.py
