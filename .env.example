# Outpost — rung 1 (self-host) configuration. Copy to .env and fill in.
# Rung 2 (Railway) uses template variables instead of this file.

# --- Forge / GitPDM ---------------------------------------------------------
# Provider must match the token's host. "github" or "generic" are the day-one
# supported paths; generic = any git remote via PAT-in-URL or ambient SSH.
GITPDM_PROVIDER=github
GITPDM_HOST=github.com

# A scoped token used as BOTH the git credential and the host-API identity check.
# GitHub: a fine-grained or classic PAT with `repo` scope. Passed via env on rung 1
# (accepted exposure on a box you own); the gatekeeper moves this to a tmpfs file
# on rung 2. Leave blank to start empty and authenticate from GitPDM's panel.
GITPDM_TOKEN=

# Repo to clone on boot (shallow, depth 20). Optional — omit to land in GitPDM's
# first-run panel and clone/create from there.
GIT_REMOTE_URL=

# --- Container runtime ------------------------------------------------------
# Match these to your host user so bind-mounted files aren't root-owned.
PUID=1000
PGID=1000
TZ=UTC

# Relaunch FreeCAD in-place if it crashes, without restarting the container.
RESTART_APP=true

# UI scale for the streamed FreeCAD window. FreeCAD 1.1 (Qt6) renders a larger UI on the
# fixed-DPI virtual display than 1.0.x did; the image defaults to 0.9 to compensate.
# Lower = smaller UI (try 0.85–1.0). Takes effect on `docker compose up -d` (recreate) —
# no rebuild needed, so dial it in live. Also available: QT_FONT_DPI (fonts only, e.g.
# 96) and QT_ENABLE_HIGHDPI_SCALING=0 (disable auto-scaling entirely) if you want them.
# QT_SCALE_FACTOR=0.9

# --- Tailscale (Phase 2) ----------------------------------------------------
# Only used by the tailscale overlay:
#   docker compose -f docker-compose.yml -f compose.tailscale.yml up -d --build
# The base docker-compose.yml alone stays localhost-only and ignores these.
#
# An auth key from https://login.tailscale.com/admin/settings/keys (ephemeral +
# pre-approved recommended). Leave BLANK to bring the node up interactively — the
# tailscale container prints a one-time login URL to its logs:
#   docker compose logs -f tailscale
TS_AUTHKEY=

# Extra `tailscale up` flags, e.g. --advertise-tags=tag:outpost. Optional.
TS_EXTRA_ARGS=

# Auth boundary marker. The tailscale overlay sets AUTH_MODE=tailscale for you
# (the tailnet is the boundary, no gatekeeper). The Phase 3 gatekeeper will read
# this; nothing consumes it on rung 1. Leave unset here.
# AUTH_MODE=
