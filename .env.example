# Outpost — rung 1 (self-host) configuration. Copy to .env and fill in.
# Rung 2 (Railway) uses template variables instead of this file.

# --- Forge / GitPDM ---------------------------------------------------------
# Provider must match the token's host. "github" or "generic" are the day-one
# supported paths; generic = any git remote via PAT-in-URL or ambient SSH.
GITPDM_PROVIDER=github
GITPDM_HOST=github.com

# A scoped token used as BOTH the git credential and the host-API identity check.
# GitHub: a fine-grained or classic PAT with `repo` scope. Passed via env on rung 1
# (accepted exposure on a box you own); the gatekeeper moves this to a tmpfs file
# on rung 2. Leave blank to start empty and authenticate from GitPDM's panel.
GITPDM_TOKEN=

# Repo to clone on boot (shallow, depth 20). Optional — omit to land in GitPDM's
# first-run panel and clone/create from there.
GIT_REMOTE_URL=

# --- Container runtime ------------------------------------------------------
# Match these to your host user so bind-mounted files aren't root-owned.
PUID=1000
PGID=1000
TZ=UTC

# Relaunch FreeCAD in-place if it crashes, without restarting the container.
RESTART_APP=true

# --- Tailscale (Phase 2; leave unset for a localhost-only Phase 1 run) ------
# TS_AUTHKEY=
